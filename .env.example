# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#   chmod 600 .env          # it holds the key to every stored credential
#
# Generate the two secrets with:
#   openssl rand -hex 24    # POSTGRES_PASSWORD
#   openssl rand -hex 32    # N8N_ENCRYPTION_KEY

# The hostname you pointed at the Elastic IP. Caddy requests a cert for this,
# so the DNS A record must already resolve before you start the stack.
DOMAIN=n8n.example.com

# Let's Encrypt expiry notices. Optional but recommended.
ACME_EMAIL=you@example.com

# Pinned n8n version. Deliberately has no default: `latest` turns a routine
# `docker compose pull` into an unannounced major upgrade. Pick a tag from
# https://github.com/n8n-io/n8n/releases and bump it when you mean to.
N8N_VERSION=

# Postgres
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

# Encrypts every stored credential. Back this value up somewhere OFF the
# instance. If you lose it, the credentials in the database cannot be
# recovered even with an intact volume -- you re-enter every one by hand.
N8N_ENCRYPTION_KEY=

# Cron fires in this zone.
TZ=Asia/Karachi

# --- backup.sh ---------------------------------------------------------
# S3 prefix for nightly dumps, e.g. s3://my-bucket/n8n. Leave empty and the
# backups sit on the same disk as the data, which the next instance failure
# takes with it. The instance needs an IAM role with s3:PutObject here.
BACKUP_S3=
KEEP_DAYS=14
