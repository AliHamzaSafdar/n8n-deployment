# Optional: uncomment and set a real address to get Let's Encrypt expiry
# warnings. Caddy renews automatically either way, so this is a safety net,
# not a requirement. An EMPTY value here is a parse error -- either give the
# directive a real address or leave the whole block commented out.
#
# {
# 	email you@example.com
# }

{$DOMAIN} {
	encode zstd gzip

	# n8n is not port-published, so this is the only route into it.
	reverse_proxy n8n:5678 {
		# Chat / SSE responses stream. Without these two, long agent replies
		# and the chat UI hang until the whole response is buffered.
		flush_interval -1
		transport http {
			read_timeout 30m
		}
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
